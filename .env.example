# Environment Variables for Srujaan Share Market Institute CRM
# Copy this file to .env and populate values locally (never commit .env to version control).

# Server-Side AI API Keys (never prefix with VITE_ so they are not bundled into client JS)
GEMINI_API_KEY=""
SSMIGEMINI_API_KEY=""
API_KEY=""
PORT="3000"

# Firebase Web Configuration (injected via Vite import.meta.env)
VITE_FIREBASE_PROJECT_NAME="SSMI CRM"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="new-project-ssmi.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="new-project-ssmi"
VITE_FIREBASE_STORAGE_BUCKET="new-project-ssmi.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="296817342226"
VITE_FIREBASE_APP_ID="1:296817342226:web:28b17a78b35cb9bc38e5cb"
VITE_FIRESTORE_DATABASE_ID=""
