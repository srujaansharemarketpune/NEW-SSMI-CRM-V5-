    },
    "/institutes/{instituteId}/lectures/{lectureId}": {
      "schema": "LectureSession",
      "description": "Lecture sessions collection inside the shared workspace"
    },
    "/institutes/{instituteId}/certificates/{certificateId}": {
      "schema": "Certificate",
      "description": "Issued certificates collection inside the shared workspace"
    },
    "/institutes/{instituteId}/attendance/{attendanceId}": {
      "schema": "AttendanceSession",
      "description": "Attendance sessions collection inside the shared workspace"
    },
    "/institutes/{instituteId}/payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Atomic fee payment records inside the shared workspace"
    },
    "/institutes/{instituteId}/fees/{feeId}": {
      "schema": "PaymentRecord",
      "description": "Fee payment records inside the shared workspace (ssmi_master_db)"
    },
    "/institutes/{instituteId}/audit_logs/{auditId}": {
      "schema": "AuditLog",
      "description": "CRM audit log entries inside the shared workspace"
    },
    "/institutes/{instituteId}/daily_queue/{queueId}": {
      "schema": "DailyQueueItem",
      "description": "Daily WhatsApp follow-up queue inside the shared workspace"
    },
    "/institutes/{instituteId}/settings/{settingId}": {
      "schema": "InstituteSettings",
      "description": "Institute settings and integration configuration inside the shared workspace"
    },
    "/institutes/{instituteId}/backups/{backupId}": {
      "schema": "BackupSnapshot",
      "description": "Cloud backup audit records and snapshots inside the shared workspace"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated user profiles"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Legacy top-level student records (read/migration compatibility)"
    },
    "/admissions/{admissionId}": {
      "schema": "Student",
      "description": "Top-level student admissions records"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Legacy top-level lead records (read/migration compatibility)"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Lead",
      "description": "Legacy top-level inquiries collection (read/migration compatibility)"
    },
    "/batches/{batchCode}": {
      "schema": "Batch",
      "description": "Legacy top-level batches collection (read/migration compatibility)"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Legacy top-level courses collection (read/migration compatibility)"
    },
    "/staff/{staffId}": {
      "schema": "StaffMember",
      "description": "Legacy top-level staff collection (read/migration compatibility)"
    },
    "/settings/{settingId}": {
      "schema": "InstituteSettings",
      "description": "Legacy top-level settings collection (read/migration compatibility)"
    },
    "/backups/{backupId}": {
      "schema": "BackupSnapshot",
      "description": "Top-level cloud backup snapshots"
    },
    "/payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Legacy top-level payments collection"
    },
    "/fees/{feeId}": {
      "schema": "PaymentRecord",
      "description": "Legacy top-level fee records"
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceSession",
      "description": "Legacy top-level attendance records"
    },
    "/expenses/{expenseId}": {
