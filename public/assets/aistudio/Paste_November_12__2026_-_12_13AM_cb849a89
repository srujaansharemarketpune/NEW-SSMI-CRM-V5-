// ==========================================
// 1. FIREBASE / FIRESTORE
// ==========================================
app.post('/api/firestore/ping', async (req, res) => {
  await delay(120);
  res.json({ success: true, latency: '120ms', status: 'Firestore Cloud Connected' });
});

app.post('/api/firestore/write', async (req, res) => {
  await delay(150);
  const record = req.body || { id: `doc_${Date.now()}`, name: 'New Student', created: new Date().toISOString() };
  memoryStore.firestore.push(record);
  res.json({ success: true, message: 'Document written successfully', record });
});

app.get('/api/firestore/read', async (req, res) => {
  await delay(100);
  res.json({ success: true, data: memoryStore.firestore });
});

app.get('/api/firestore/backup', (req, res) => {
  res.setHeader('Content-Disposition', 'attachment; filename=firestore_backup.json');
  res.setHeader('Content-Type', 'application/json');
  res.send(JSON.stringify(memoryStore.firestore, null, 2));
});

app.post('/api/firestore/restore', (req, res) => {
  const { backupData } = req.body;
  if (Array.isArray(backupData)) {
    memoryStore.firestore = backupData;
    return res.json({ success: true, count: backupData.length, message: 'Firestore state restored' });
